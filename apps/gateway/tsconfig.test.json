{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    /* `rootDir` must be released: the base config pins it to ./src, and a
       test/** file outside it is TS6059 ("not under rootDir"). */
    "rootDir": "."
  },
  "include": ["src/**/*", "test/**/*"]
}