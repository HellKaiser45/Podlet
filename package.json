{
  "name": "podlet-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  
  "scripts": {
    "init": "bun run scripts/init.ts",
    "start": "bun run scripts/start.ts",
    "dev:gateway": "bun --filter @podlet/gateway dev",
    "dev:web": "bun --filter @podlet/web dev"
  }
,
  "dependencies": {
    "@elysiajs/openapi": "^1.4.14",
    "officeparser": "^6.0.7",
    "podlet-monorepo": ".",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/bun": "latest"
  },
  "module": "index.ts",
  "type": "module"
}
