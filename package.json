{
  "name": "podlet-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init": "bun run scripts/init.ts",
    "start": "bun run scripts/start.ts",
    "models:upgrade": "bun run scripts/models-upgrade.ts",
    "mcp:probe": "bun run apps/gateway/scripts/probe-mcp-schemas.ts",
    "dev:gateway": "bun --filter @podlet/gateway dev",
    "dev:web": "bun --filter @podlet/web dev"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.14"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/bun": "latest"
  },
  "type": "module"
}
