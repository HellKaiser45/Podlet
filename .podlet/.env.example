OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=

# ---- App identity headers sent with every LLM request ----
# Custom User-Agent override. Default: podlet/<gateway version> (e.g. podlet/1.0.50).
# Required by OpenCode Go; recommended for provider-side analytics.
PODLET_USER_AGENT=
# OpenRouter app attribution (auto-sent for openrouter models)
OPENROUTER_APP_TITLE=Podlet
OPENROUTER_APP_REFERER=https://github.com/HellKaiser45/Podlet

# ---- OpenCode Go (https://opencode.ai) ----
# API key for the "opencode" model entry in models.json
OPENCODE_API_KEY=
