# Podlet Docker Configuration (OPTIONAL)
# ========================================
# No .env file is needed for standard setups.
# Podlet data is always at ~/.podlet, mounted automatically.
#
# Only create a .env file if you need to override the port:
#   cp .env.docker.example .env

# Optional: Port exposed on the host (default: 3002)
# GATEWAY_PORT=3002
