# Podlet Docker Configuration
# Copy this file to .env and adjust values:
#   cp .env.docker.example .env
#   # Then edit .env to set your actual data directory path

# Required: Absolute path to your Podlet data directory on the host.
# This is where your config, agents, prompts, DB, and API keys live.
# It gets mounted as /root/.podlet inside the container.
PODLET_DIR=/home/YOUR_USERNAME/.podlet

# Optional: Port exposed on the host (default: 3002)
# GATEWAY_PORT=3002
