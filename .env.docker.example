# Podlet Docker Configuration (OPTIONAL)
# ========================================
# No .env file is needed for standard setups.
# Podlet data is always at ~/.podlet, which Docker mounts automatically.
#
# Only create a .env file if you need to override defaults:
#   cp .env.docker.example .env

# Optional: Override the Podlet data directory on the host.
# Defaults to ~/.podlet
# PODLET_DIR=/home/YOUR_USERNAME/.podlet

# Optional: Port exposed on the host (default: 3002)
# GATEWAY_PORT=3002
